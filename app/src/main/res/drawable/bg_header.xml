<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient android:angle="315" android:startColor="#7B3FF2"
                android:centerColor="#5A55EE" android:endColor="#2F80ED" />
            <corners android:bottomLeftRadius="32dp" android:bottomRightRadius="32dp" />
        </shape>
    </item>
    <item android:width="220dp" android:height="220dp" android:gravity="top|end"
        android:top="-90dp" android:end="-70dp">
        <shape android:shape="oval"><solid android:color="#1AFFFFFF" /></shape>
    </item>
    <item android:width="140dp" android:height="140dp" android:gravity="bottom|start"
        android:bottom="-40dp" android:start="-30dp">
        <shape android:shape="oval"><solid android:color="#14FFFFFF" /></shape>
    </item>
</layer-list>
